<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Klanker</AssemblyName>
    <RootNamespace>Klanker</RootNamespace>
    <Version>0.1.1</Version>

    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)../../build/GameData/Klanker</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
    <KSPBT_CKANCompatibleVersions>1.12</KSPBT_CKANCompatibleVersions>
    <KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
    <KSPBT_GenerateVersionFile>false</KSPBT_GenerateVersionFile>
    <!-- KSPBuildTools appends dependency attributes after the SDK's incremental
         assembly-info hash. Declare ours early so metadata edits rebuild it. -->
    <KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
                      GeneratePathProperty="true"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.ClearScript.V8" />
    <PackageReference Include="Microsoft.ClearScript.V8.ICUData" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stripped KSP archive omits these Mono framework references. They are
         compile-only and come from Microsoft's cross-platform reference pack. -->
    <Reference Include="Microsoft.CSharp">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2/Microsoft.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2/System.ComponentModel.Composition.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Numerics">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2/System.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="KSPAssemblyDependency">
      <_Parameter1>MechJeb2</_Parameter1>
      <_Parameter2>2</_Parameter2>
      <_Parameter2_TypeName>System.Int32</_Parameter2_TypeName>
      <_Parameter3>5</_Parameter3>
      <_Parameter3_TypeName>System.Int32</_Parameter3_TypeName>
      <_Parameter4>0</_Parameter4>
      <_Parameter4_TypeName>System.Int32</_Parameter4_TypeName>
    </AssemblyAttribute>
    <ModReference Include="MechJeb2">
      <DLLPath>GameData/MechJeb2/Plugins/MechJeb2.dll</DLLPath>
      <KSPAssemblyName>MechJeb2</KSPAssemblyName>
      <!-- KSPAssembly is an API identity, not the release/CKAN version. -->
      <KSPAssemblyVersion>2.5.0</KSPAssemblyVersion>
      <CKANIdentifier>MechJeb2</CKANIdentifier>
      <CKANVersion>2.14.3.0</CKANVersion>
      <Private>false</Private>
    </ModReference>
  </ItemGroup>
</Project>
