{
    // Type-checks every TypeScript source in the repository. Node 22.18+ runs
    // cli/, scripts/, and tests/ directly by stripping types, so those imports
    // use explicit `.ts` extensions. `lib/` is bundled by esbuild (never loaded
    // by Node), so it keeps bundler-style extensionless imports.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        // Workers import the stdlib as `klanker` / `klanker/<name>`; map those
        // to lib/ so the workspace type-check resolves them the way the bundler does.
        "baseUrl": ".",
        "paths": {
            "klanker": ["./lib/index.ts"],
            "klanker/*": ["./lib/*"]
        }
    },
    "include": ["Herebyfile.ts", "cli/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "workers/**/*.ts"],
    "exclude": ["node_modules", "cli/dist", "build", ".cache", ".nuget"]
}
